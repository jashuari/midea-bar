{
  "name": "midea-bar",
  "productName": "MideaBar",
  "version": "0.5.1",
  "description": "Menu bar control for Midea air conditioners over the local network",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jashuari/midea-bar.git"
  },
  "author": "Arijanit Jashari",
  "main": "dist/main.cjs",
  "bin": {
    "midea": "dist/cli.cjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "start": "npm run build && electron .",
    "cli": "npm run build --silent && node dist/cli.cjs",
    "fake-ac": "tsx scripts/fake-ac.ts",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "midea-local": "0.1.2"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^22.10.0",
    "electron": "^44.7.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
